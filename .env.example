# Configurar no ambiente do processo; este arquivo não é carregado automaticamente.
OPENAI_API_KEY=
OPENAI_MODEL=
# Tentativas por geração (1 a 10); admite no máximo um reparo de validação.
COTERA_LLM_MAX_ATTEMPTS=3
# Limites opcionais conservadores por documento (incluem retries e reparo).
# COTERA_LLM_MAX_TOKENS=100000
# COTERA_LLM_MAX_COST_USD=0.10
# COTERA_LLM_PRICING_PATH=cotera/llm_pricing.json
# Padrão local: SQLite em storage/cotera.sqlite3.
# COTERA_DATABASE_URL=postgresql://cotera@127.0.0.1:5432/cotera
COTERA_DB_PASSWORD=
COTERA_API_KEY=
# Tempo total de OCR por PDF, em segundos (padrão: 30).
COTERA_OCR_TIMEOUT_SECONDS=30
# Somente Docker Compose: defina uma senha antes de subir o perfil integrated.
POSTGRES_PASSWORD=
